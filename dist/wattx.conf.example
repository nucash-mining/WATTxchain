# WATTx Testnet v0.1.0 Configuration
# Linux:   ~/.wattx-testnet/wattx.conf
# macOS:   ~/Library/Application Support/WATTx/testnet3/wattx.conf
# Windows: %APPDATA%\WATTx\testnet3\wattx.conf

server=1
listen=1
txindex=1

[test]
# Hardcoded bootstrap seednode
addnode=76.131.208.215:13888

# RPC access (required for CLI and mobile wallet)
rpcuser=wattxrpc
rpcpassword=change_me_to_something_secure
rpcallowip=127.0.0.1

# Enable staking
staking=1

# Uncomment to expose RPC for remote mobile wallet connection
# rpcallowip=0.0.0.0/0
# rpcbind=0.0.0.0
